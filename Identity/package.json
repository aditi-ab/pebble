  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aditi-ab/pebble.git",
    "directory": "Identity"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": ["**/*.css"],
  "exports": {
